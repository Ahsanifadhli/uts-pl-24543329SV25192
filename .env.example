# ============================================
# Konfigurasi SPIRA — salin ke .env lalu isi
# nilai rahasianya (.env TIDAK ikut di-commit)
# ============================================

# --- Basis Data (MySQL) ---
DB_DATABASE=spira
DB_USERNAME=spira_user
DB_PASSWORD=ganti_dengan_password_aman
DB_ROOT_PASSWORD=ganti_dengan_root_password_aman

# --- Backend (Laravel) ---
APP_KEY=
APP_ENV=local
APP_DEBUG=true

# --- Frontend (Vue) ---
VITE_API_URL=http://localhost:8000/api

# --- Grafana (Pemantauan) ---
# Password admin WAJIB diganti dari bawaan admin/admin.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ganti_dengan_password_grafana_aman
