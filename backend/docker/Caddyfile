{
	frankenphp
	order php_server before file_server

	# Admin API dibuka agar Prometheus dapat mengambil metrik dari luar container.
	admin 0.0.0.0:2019
	# Aktifkan metrik HTTP Caddy (sumber data "permintaan per detik").
	servers {
		metrics
	}
}

:8000 {
	root * /app/public
	encode zstd br gzip

	# Catat setiap permintaan ke stdout (terlihat di log container)
	log {
		output stdout
		format console
	}

	php_server
}
